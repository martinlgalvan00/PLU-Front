{
  "pkg": "plu-arg-maximal",
  "globalName": "PLUARG",
  "shape": "storybook",
  "entry": "./.design-sync/entry.js",
  "storybookStatic": ".design-sync/sb-reference",
  "provider": {
    "component": "ThemeProvider",
    "inner": {
      "component": "I18nProvider",
      "inner": {
        "component": "OAuthProvider"
      }
    }
  },
  "runtimeFontPrefixes": ["Poppins", "JetBrains Mono"],
  "overrides": {
    "NavbarPublic": { "cardMode": "column" },
    "PlatformMap": { "cardMode": "column" },
    "ResultsArchiveList": { "cardMode": "column" },
    "CardPreviewModal": { "cardMode": "single", "primaryStory": "Open" },
    "EventShareCard": { "viewport": "900x1700" }
  }
}
