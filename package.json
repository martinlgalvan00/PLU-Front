{
  "name": "plu-arg-maximal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev:services",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "dev:services": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:all": "node scripts/bootstrap-all.mjs --start",
    "setup:all": "node scripts/bootstrap-all.mjs",
    "start:all": "npm run dev:all",
    "postinstall": "prisma generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src server",
    "lock:check": "node scripts/check-lockfile.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"tests/**/*.js\"",
    "test": "npm run test:unit && npm run test:storybook",
    "test:check": "npm run lint && npm run test && npm run build",
    "test:unit": "vitest run --project default",
    "test:storybook": "vitest run --project storybook",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "visual-check": "node scripts/visual-check.mjs",
    "db:studio": "node scripts/prisma-supabase.mjs studio",
    "db:generate": "node scripts/prisma-supabase.mjs generate",
    "db:migrate": "npm run setup:all",
    "db:seed": "node scripts/prisma-supabase.mjs seed",
    "db:verify:payments": "node scripts/verify-payment-database.mjs",
    "db:verify:schema": "node scripts/verify-schema-posture.mjs",
    "supabase:assert": "node scripts/assert-supabase-connectivity.mjs",
    "supabase:diagnose": "node scripts/diagnose-supabase-integration.mjs",
    "email:doctor": "node scripts/email-doctor.mjs",
    "invite:doctor": "node scripts/invite-doctor.mjs",
    "email:previews": "node scripts/render-email-previews.mjs",
    "share-cards:previews": "node scripts/render-share-card-previews.mjs",
    "mercado-pago:doctor": "node scripts/mercado-pago-doctor.mjs",
    "payments:audit": "node scripts/payments-audit.mjs",
    "payments:trace": "node scripts/payments-trace.mjs",
    "purge:test-athletes": "node scripts/purge-test-athletes.mjs",
    "mercado-pago:urls": "node scripts/mercado-pago-urls.mjs",
    "git:push-check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-unpushed-commits.ps1 -Notify",
    "git:push-reminder:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-push-reminder.ps1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "design:import": "node scripts/import-claude-design.mjs",
    "design:extract": "node scripts/extract-design-ref.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@auth0/auth0-react": "^2.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.45.4",
    "antd": "^6.6.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.22",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.9.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^6.1.0",
    "mercadopago": "^3.2.0",
    "motion": "^12.42.2",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "overrides": {
    "valibot": "1.4.2",
    "deepmerge-ts": "8.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "prisma": "^6.16.2",
    "prop-types": "^15.8.1",
    "sharp": "^0.35.3",
    "storybook": "^10.4.6",
    "supabase": "2.109.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
