# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# --- Auth ---
AUTH_SECRET=

# --- Mercado Pago ---
# true  = simula cobros en local (sin llamar a MP). Solo permitido en local/dev.
# false = usa Mercado Pago real (sandbox o production segun MERCADO_PAGO_ENV).
# En Vercel Preview (DEV) y Production: PAYMENTS_MOCK=false.
PAYMENTS_MOCK=true
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENV=sandbox
# Secret del panel MP (Webhooks) de la misma app TEST/PROD.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- App ---
# Local: http://localhost:5173
# DEV (Vercel Preview rama dev):
#   https://plu-git-dev-martinlgalvan00s-projects.vercel.app
# PROD:
#   https://www.powerliftingunited.ar
# Webhook MP = {APP_URL}/api/payments/webhook/mercadopago (mismo origen; API_URL = APP_URL).
# Alias legacy: {APP_URL}/api/payments/webhook
# En Vercel se pueden dejar vacías: el runtime usa automáticamente la URL
# estable de Production o de la rama Preview. En local usar http://localhost:5173.
APP_URL=
API_URL=
# true  = UI/comportamiento de producción (oculta WIP, demos, atajos).
# false = local/preview con módulos incompletos visibles.
# En Vercel Production: true. En local: false.
APP_PRODUCTION=false

