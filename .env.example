# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# --- Auth ---
AUTH_SECRET=

# --- Mercado Pago ---
# true  = simula cobros en local (sin llamar a MP). Solo permitido en local/dev.
# false = usa Mercado Pago real (sandbox o production segun MERCADO_PAGO_ENV).
# En Vercel Preview (DEV) y Production: PAYMENTS_MOCK=false.
PAYMENTS_MOCK=true
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENV=sandbox
# Secret del panel MP (Webhooks) de la misma app TEST/PROD.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- App ---
# Local: http://localhost:5173
# DEV (Vercel Preview rama dev):
#   https://plu-git-dev-martinlgalvan00s-projects.vercel.app
# PROD:
#   https://www.powerliftingunited.ar
# Webhook MP = {APP_URL}/api/payments/webhook/mercadopago (mismo origen; API_URL = APP_URL).
# Alias legacy: {APP_URL}/api/payments/webhook
# En Vercel se pueden dejar vacías: el runtime usa automáticamente la URL
# estable de Production o de la rama Preview. En local usar http://localhost:5173.
APP_URL=
API_URL=
# true  = UI/comportamiento de producción (oculta WIP, demos, atajos).
# false = local / Vercel Preview con módulos incompletos visibles.
# En Vercel Production: true. En Vercel Preview y local: false.
# Con true se oculta la afiliación automática (recurring) y se bloquean
# escrituras de configuración económica hasta habilitarlas.
APP_PRODUCTION=false

# Gate de cobros (afiliación, inscripción, combo, entradas).
# Vacío + APP_PRODUCTION=true = cerrado (“Próximamente”). La fecha
#         "Abre la inscripción" del admin alimenta el countdown, no Mercado Pago.
#         Fuera de producción queda abierto para pruebas.
# true  = forzar apertura (día del launch en Vercel Production).
# false = forzar cierre aunque APP_PRODUCTION=false.
PAID_CHECKOUT_ENABLED=

# --- Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_TOKEN=

# --- Analítica de uso del sitio (docs/ANALYTICS.md) ---
# Sal del hash de visitante. La IP nunca se guarda: entra a este hash con
# rotación diaria y se descarta. Si falta, se reusa AUTH_SECRET.
# Rotarla corta la continuidad de visitantes a partir de ese momento.
ANALYTICS_SALT_SECRET=
# Kill switch del tracker. Ausente o distinto de 'false' = encendido.
VITE_ANALYTICS_ENABLED=true
