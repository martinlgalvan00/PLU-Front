# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# --- Auth ---
AUTH_SECRET=

# --- Mercado Pago ---
# true  = simula cobros en local (sin llamar a MP). Solo permitido en local/dev.
# false = usa Mercado Pago real (sandbox o production segun MERCADO_PAGO_ENV).
# En Vercel Preview (DEV) y Production: PAYMENTS_MOCK=false.
PAYMENTS_MOCK=true
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENV=sandbox
# Secret del panel MP (Webhooks) de la misma app TEST/PROD.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- App ---
# Local: http://localhost:5173
# DEV (Vercel Preview rama dev):
#   https://plu-git-dev-martinlgalvan00s-projects.vercel.app
# PROD:
#   https://www.powerliftingunited.ar
# Webhook MP = {APP_URL}/api/payments/webhook/mercadopago (mismo origen).
# Alias legacy: {APP_URL}/api/payments/webhook
# En Vercel se pueden dejar vacías: el runtime usa automáticamente la URL
# estable de Production o de la rama Preview. En local usar http://localhost:5173.
APP_URL=
# Opcional: sólo si la API vive en otro origen. Si falta, se usa APP_URL.
# API_URL=
# true  = UI/comportamiento de producción (oculta WIP, demos, atajos).
# false = local / Vercel Preview con módulos incompletos visibles.
# En Vercel Production: true. En Vercel Preview y local: false.
# Con true se oculta la afiliación automática (recurring) y se bloquean
# escrituras de configuración económica hasta habilitarlas.

# Pausar/reabrir cobros (afiliación, inscripción, entradas, suscripciones) se
# hace desde el panel: Administración > Acceso y habilitación > "Cobros
# generales". No hace falta tocar Vercel ni redeployar.
# PAID_CHECKOUT_ENABLED queda en el código solo como freno de emergencia si
# Supabase no respondiera (el panel no podría leerse); no es la vía operativa
# y no debería configurarse en Vercel salvo ese escenario puntual.
# PAID_CHECKOUT_ENABLED=

# Origenes permitidos para las llamadas del navegador, separados por coma.
# Vacío = solo el propio origen de la app (lo normal: front y API comparten
# dominio). Se usa para los previews de Vercel o un front en otro host.
ALLOWED_ORIGINS=

# --- Jobs internos ---
# Bearer que exige /api/internal/jobs/*. Lo mandan el cron de Vercel
# (vercel.json) y el workflow payment-recovery-cron.yml, que sin este valor
# falla en vez de disparar el job sin autenticar. Sin definir, los endpoints
# internos quedan cerrados.
CRON_SECRET=

# --- Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_TOKEN=
# URL HTTPS absoluta del logo visible en emails (opcional; por defecto usa
# https://www.powerliftingunited.ar/brand/plu-argentina-email.png).
EMAIL_LOGO_URL=

# --- Analítica de uso del sitio (docs/ANALYTICS.md) ---
# Sal del hash de visitante. La IP nunca se guarda: entra a este hash con
# rotación diaria y se descarta. Si falta, se reusa AUTH_SECRET.
# Rotarla corta la continuidad de visitantes a partir de ese momento.
ANALYTICS_SALT_SECRET=
# Kill switch del tracker. Ausente o distinto de 'false' = encendido.
VITE_ANALYTICS_ENABLED=true

# --- Observabilidad del servidor (docs/PAYMENTS_OPERATIONS.md) ---
# Nivel del log estructurado: debug | info | warn | error | silent.
# Sin definir: debug en local, info en produccion, error en tests.
LOG_LEVEL=
# true = log indentado y legible en la terminal. En Vercel dejarlo vacío:
# una línea JSON por evento es lo que la plataforma sabe indexar.
LOG_PRETTY=

# --- Capa de defensa (docs/SECURITY.md) ---
# Estado compartido del rate limit en Postgres. Sin esto, en Vercel cada
# instancia cuenta por separado y el límite real es "N por instancia".
# Ausente o distinto de 'false' = encendido cuando hay SUPABASE_URL.
# Sólo ponerlo en 'false' para aislar un problema: apagarlo deja los límites
# valiendo por proceso, que es como estaban antes.
SHARED_RATE_LIMIT_ENABLED=
# Hasheos de contraseña simultáneos por instancia. bcryptjs coste 12 son ~250 ms
# de un solo hilo que no cede el event loop: sin techo, un puñado de logins
# concurrentes deja la instancia sin atender webhooks ni check-in. Default: 4.
PASSWORD_HASH_CONCURRENCY=
