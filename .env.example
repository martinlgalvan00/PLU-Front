# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# --- Auth ---
AUTH_SECRET=

# Puerto de la API local (default 3001). Si esta ocupado por otro proyecto,
# usa otro (ej. PORT=3003): Vite proxyea /api a ese mismo PORT.
# PORT=3003

# --- Seed admin ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin_plu_arg
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=PLU

# --- Mercado Pago ---
# Local sin pagar: usa mock (recorre el workflow real sin llamar a MP).
# Sandbox/produccion: mercado_pago + credenciales debajo.
PAYMENTS_PROVIDER=mock
VITE_PAYMENTS_PROVIDER=mock
# Opcional: demora artificial (ms, max 10000) para probar pending/polling.
# MOCK_PAYMENT_DELAY_MS=800
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENV=sandbox
# Clave de firma del webhook (panel de MP > Webhooks > "Clave secreta").
# SIN ESTO NO SE ACREDITA NINGUN PAGO: el verificador falla cerrado y responde
# 503 a cada notificacion, asi que la afiliacion nunca pasa a activa y el socio
# nunca recibe su credencial. Faltaba en este archivo.
# Con PAYMENTS_PROVIDER=mock no hace falta (hay POST /api/payments/mock/notify).
MERCADO_PAGO_WEBHOOK_SECRET=
# Tolerancia del timestamp de la firma, en segundos. Default 300.
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
# 'true' confirma el webhook apenas queda persistido y procesa los efectos en
# el worker durable. Recomendado en produccion: Mercado Pago reintenta si la
# respuesta tarda, y sin esto cada notificacion espera la consulta canonica.
PAYMENT_RECOVERY_JOB_ENABLED=false
PAYMENT_RECOVERY_JOB_INTERVAL_MS=60000
# Activar solo con un worker o cron frecuente (ideal <= 1 minuto). En false,
# el webhook acredita inline y recovery sigue cubriendo fallas transitorias.
PAYMENT_WEBHOOK_DEFER_PROCESSING=false

# --- App ---
# URL pública del front (logo de emails, links de verificación/reset).
# En Vercel suele resolverse sola; en local: http://localhost:5173
APP_URL=
VITE_APP_URL=

# --- Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_TOKEN=
