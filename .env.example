# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=

# ─── Seed admin ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin_plu_arg
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=PLU

# ─── Mercado Pago ────────────────────────────────────────────────────────────
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENV=sandbox
# Clave de firma del webhook (panel de MP > Webhooks > "Clave secreta").
# SIN ESTO NO SE ACREDITA NINGÚN PAGO: el verificador falla cerrado y responde
# 503 a cada notificación, así que la afiliación nunca pasa a activa y el socio
# nunca recibe su credencial. Faltaba en este archivo.
MERCADO_PAGO_WEBHOOK_SECRET=
# Tolerancia del timestamp de la firma, en segundos. Default 300.
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
# 'true' confirma el webhook apenas queda persistido y procesa los efectos en
# el worker durable. Recomendado en producción: Mercado Pago reintenta si la
# respuesta tarda, y sin esto cada notificación espera la consulta canónica.
PAYMENT_RECOVERY_JOB_ENABLED=false
PAYMENT_RECOVERY_JOB_INTERVAL_MS=60000

# ─── Brevo ───────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_TOKEN=
