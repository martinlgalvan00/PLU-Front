# App
VITE_APP_URL=http://localhost:5173
# Vacío en Vercel: el browser usa /api en el mismo origen. En local, Vite
# también proxifica /api al proceso Express.
VITE_API_URL=http://localhost:3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# El mapa público usa MapLibre + OpenFreeMap. No requiere API key ni Map ID.
# Estos endpoints son opcionales y permiten reemplazar las instancias públicas
# por infraestructura propia sin cambiar la interfaz.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Separar con comas solamente si existe otro frontend autorizado.
ALLOWED_ORIGINS=
# Los accesos hardcodeados de demostración quedan apagados por defecto.
VITE_DEMO_MODE=false

# Supabase — infraestructura de eventos/ticketing (Fase 1)
# Proyecto remoto (Dashboard → Project Settings → API).
# URL base sin /rest/v1/. En browser solo anon/publishable — nunca service_role/secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Solo servidor — firmar URLs / RPCs privilegiadas (`supabase status` o Dashboard → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Postgres: preferí el pooler Session mode (puerto 5432) si db.* solo resuelve IPv6.
# El bootstrap deriva DATABASE_URL y guarda Prisma en el schema `plu_prisma`.
# Formato: postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# Auth
# BOOTSTRAP_SKIP_MIGRATIONS=1  # saltea Prisma migrate + supabase db push en npm run dev
AUTH_SECRET=generar-un-secreto-largo-y-aleatorio
SESSION_COOKIE_SECURE=false
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Seed admin local (sin valores por defecto por seguridad)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin_plu_arg
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=PLU

# Mercado Pago — NUNCA confirmar pagos desde frontend
# Reemplazar ambos `TEST-xxxx`: son marcadores, no credenciales válidas.
# En producción, APP_URL y API_URL deben ser URLs públicas HTTPS.
VITE_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxx
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECOVERY_JOB_ENABLED=false
PAYMENT_RECOVERY_JOB_INTERVAL_MS=60000
PAYMENT_RECOVERY_BATCH_SIZE=20
DOMAIN_MAINTENANCE_JOB_ENABLED=true
DOMAIN_MAINTENANCE_JOB_INTERVAL_MS=60000
# Ciclo de vida de cuentas seguridad_plu_arg: al terminar el evento las
# desactiva, y pasada la gracia las borra. Habilitado salvo que sea 'false'.
SECURITY_USER_LIFECYCLE_JOB_ENABLED=true
SECURITY_USER_LIFECYCLE_JOB_INTERVAL_MS=3600000
SECURITY_USER_PURGE_GRACE_MS=86400000
# Protege GET /api/internal/jobs/*. Generar un valor aleatorio distinto por entorno.
CRON_SECRET=

# Transferencia (datos publicos mostrados al pagador)
VITE_PAYMENT_TRANSFER_ALIAS=
VITE_PAYMENT_TRANSFER_CBU=
VITE_PAYMENT_TRANSFER_HOLDER=

# Brevo — emails transaccionales
# La API key vive SOLO en el servidor. El frontend nunca llama a Brevo: pide
# el envío a /api/emails y el backend resuelve template y credenciales.
BREVO_API_KEY=
# CRÍTICO: este remitente tiene que estar validado en Brevo, o su dominio
# autenticado por DNS (SPF/DKIM). Si no lo está, la API responde 201 igual y
# rechaza el envío DESPUÉS, de forma asincrónica: los logs quedan en 'sent' y
# no se entrega nada. Verificar con `npm run email:doctor`.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PLU ARG
# Adónde contesta el destinatario si aprieta "Responder". Por defecto, el remitente.
BREVO_REPLY_TO_EMAIL=
BREVO_TIMEOUT_MS=10000
BREVO_MAX_ATTEMPTS=3
# Token compartido que protege POST /api/emails/webhook/brevo. Brevo no firma
# el payload, así que se manda como ?token=... en la URL del webhook que se
# configura en el dashboard. Generar un valor aleatorio distinto por entorno.
BREVO_WEBHOOK_TOKEN=

# Template IDs (numéricos, del dashboard de Brevo). Cada uno es OPCIONAL: si
# falta, el email igual sale con el fallback HTML del repo
# (server/modules/notifications/emailTemplates.js). Cargar el template acá lo
# convierte automáticamente en la versión que se envía.
# Ver el estado de cada uno en GET /api/emails/catalog.
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_EMAIL_VERIFICATION=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_SECURITY_ACCESS=
BREVO_TEMPLATE_AFFILIATION_STARTED=
BREVO_TEMPLATE_AFFILIATION_APPROVED=
BREVO_TEMPLATE_MEMBERSHIP_RENEWAL=
BREVO_TEMPLATE_PAYMENT_APPROVED=
BREVO_TEMPLATE_PAYMENT_RECEIPT=
BREVO_TEMPLATE_PAYMENT_PENDING=
BREVO_TEMPLATE_PAYMENT_REJECTED=
BREVO_TEMPLATE_REGISTRATION_CONFIRMED=
BREVO_TEMPLATE_TICKET_CONFIRMATION=
BREVO_TEMPLATE_EVENT_ANNOUNCEMENT=
BREVO_TEMPLATE_EVENT_REMINDER=
BREVO_TEMPLATE_ADMIN_NOTIFICATION=
BREVO_TEMPLATE_EXPORT_READY=

# Reintento de emails fallidos. Habilitado salvo que sea 'false'.
EMAIL_DISPATCH_JOB_ENABLED=true
EMAIL_DISPATCH_JOB_INTERVAL_MS=300000
EMAIL_DISPATCH_BATCH_SIZE=50
# Envíos simultáneos. Secuencial, una audiencia de 500 tarda ~100 s y excede
# el maxDuration de 60 s de Vercel; con 8 en paralelo entra holgado sin
# gatillar el 429 de Brevo.
EMAIL_DISPATCH_CONCURRENCY=8
EMAIL_BROADCAST_CONCURRENCY=8
MEMBERSHIP_RENEWAL_JOB_ENABLED=false
MEMBERSHIP_RENEWAL_JOB_INTERVAL_MS=21600000
